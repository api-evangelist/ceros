{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ceros Accounts API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getCurrentAccount",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.ceros.com/accounts/current-account",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get current account information using API key authentication"
        }
      ]
    }
  ],
  "bundled": true
}