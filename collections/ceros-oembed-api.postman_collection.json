  "info": {
    "_postman_id": "6a043efc-a9b3-4989-aca3-76f3d5b8ce78",
    "name": "Ceros Oembed API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Public, unauthenticated oEmbed 1.0 provider endpoint for Ceros experiences. Given the canonical URL of a published Ceros experience it returns an oEmbed `rich` response containing the title, canonical URL, embed HTML (a responsive iframe plus the Ceros scroll-proxy script), and the experience's natural width/height. This is the endpoint the first-party Ceros Contentful App calls to resolve a pasted experience URL into an embed.\n\nContact Support:\n Name: Ceros",
      "type": "text/plain"
    }
  }
