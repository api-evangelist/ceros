      "item": [
        {
          "id": "8cba613e-a3d8-417e-ab1e-bc37673db521",
          "name": "Resolve a Ceros experience URL to an oEmbed response",
          "request": {
            "name": "Resolve a Ceros experience URL to an oEmbed response",
            "description": {
              "content": "Returns an oEmbed 1.0 `rich` object for a published Ceros experience. Responds 400 `Invalid Request` when `url` is not a resolvable Ceros experience, 404 when `url` is omitted, and 501 when `format=xml` is requested.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oembed"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "(Required) Canonical URL of a published Ceros experience (`view.ceros.com/...` or a `*.ceros.site` vanity domain)."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response serialisation. Only `json` is implemented; `xml` returns 501."
                },
                {
                  "disabled": false,
                  "key": "maxwidth",
                  "value": "<integer>",
                  "description": "oEmbed 1.0 maximum embed width hint. Accepted (200) — Ceros returns its own responsive embed regardless."
                },
                {
                  "disabled": false,
                  "key": "maxheight",
                  "value": "<integer>",
                  "description": "oEmbed 1.0 maximum embed height hint."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
